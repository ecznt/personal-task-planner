    "clsx": "2.1.1",
    "input-otp": "1.4.2",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "radix-ui": "1.6.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "sonner": "2.0.8",
