    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "jsdom": "29.1.1",
    "postcss": "8.5.22",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0"
