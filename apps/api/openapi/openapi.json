{
  "components": {
    "schemas": {
      "AccountDeletionProcessDataDto": {
        "properties": {
          "accessRevokedAt": {
            "format": "date-time",
            "type": "string"
          },
          "primaryPurgePending": {
            "type": "boolean"
          },
          "processId": {
            "format": "uuid",
            "type": "string"
          },
          "requestedAt": {
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "enum": [
              "PENDING_PRIMARY_PURGE"
            ],
            "type": "string"
          }
        },
        "required": [
          "processId",
          "state",
          "requestedAt",
          "accessRevokedAt",
          "primaryPurgePending"
        ],
        "type": "object"
      },
      "AccountDeletionProcessResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AccountDeletionProcessDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AccountDeletionRequestDto": {
        "properties": {
          "acknowledgedPermanentDeletion": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "confirmation": {
            "enum": [
              "DELETE_MY_ACCOUNT"
            ],
            "type": "string"
          }
        },
        "required": [
          "confirmation",
          "acknowledgedPermanentDeletion"
        ],
        "type": "object"
      },
      "AuthenticatedSessionDataDto": {
        "properties": {
          "absoluteExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "authenticated": {
            "type": "boolean"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "idleExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "next": {
            "example": "/app/today",
            "type": "string"
          }
        },
        "required": [
          "authenticated",
          "email",
          "idleExpiresAt",
          "absoluteExpiresAt",
          "next"
        ],
        "type": "object"
      },
      "CsrfTokenDataDto": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "token": {
            "description": "Non-secret CSRF token bound to the anonymous browser transaction.",
            "type": "string"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ],
        "type": "object"
      },
      "CsrfTokenResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CsrfTokenDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "CurrentUserProfileDataDto": {
        "properties": {
          "accountLifecycleState": {
            "enum": [
              "ACTIVE",
              "DELETION_CONFIRMED"
            ],
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "inAppReminderNotificationsEnabled": {
            "type": "boolean"
          },
          "onboardingState": {
            "enum": [
              "PENDING",
              "COMPLETED"
            ],
            "type": "string"
          },
          "timeZone": {
            "example": "UTC",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "timeZone",
          "onboardingState",
          "accountLifecycleState",
          "inAppReminderNotificationsEnabled"
        ],
        "type": "object"
      },
      "CurrentUserProfileResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CurrentUserProfileDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EmailVerificationRequestAcceptedDataDto": {
        "properties": {
          "status": {
            "enum": [
              "VERIFICATION_EMAIL_SENT_IF_ELIGIBLE"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "EmailVerificationRequestAcceptedResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EmailVerificationRequestAcceptedDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EmailVerificationRequestDto": {
        "properties": {
          "email": {
            "example": "kullanici@example.com",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "LoginRequestDto": {
        "properties": {
          "email": {
            "example": "kullanici@example.com",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "type": "string",
            "writeOnly": true
          },
          "returnTo": {
            "default": "/app/today",
            "example": "/app/today",
            "maxLength": 2048,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "LoginResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AuthenticatedSessionDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "OnboardingCompletionDataDto": {
        "properties": {
          "choice": {
            "enum": [
              "START_EMPTY"
            ],
            "type": "string"
          },
          "completedAt": {
            "format": "date-time",
            "type": "string"
          },
          "next": {
            "enum": [
              "/app/today"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "COMPLETED"
            ],
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUserProfileDataDto"
          }
        },
        "required": [
          "status",
          "choice",
          "completedAt",
          "next",
          "user"
        ],
        "type": "object"
      },
      "OnboardingCompletionRequestDto": {
        "properties": {
          "choice": {
            "enum": [
              "START_EMPTY"
            ],
            "type": "string"
          }
        },
        "required": [
          "choice"
        ],
        "type": "object"
      },
      "OnboardingCompletionResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/OnboardingCompletionDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "PasswordResetRequestAcceptedDataDto": {
        "properties": {
          "status": {
            "enum": [
              "PASSWORD_RESET_EMAIL_SENT_IF_ELIGIBLE"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "PasswordResetRequestAcceptedResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PasswordResetRequestAcceptedDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "PasswordResetRequestDto": {
        "properties": {
          "email": {
            "example": "kullanici@example.com",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "ReauthenticationDataDto": {
        "properties": {
          "action": {
            "enum": [
              "ACCOUNT_DELETION"
            ],
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "REAUTHENTICATED"
            ],
            "type": "string"
          }
        },
        "required": [
          "action",
          "status",
          "expiresAt"
        ],
        "type": "object"
      },
      "ReauthenticationRequestDto": {
        "properties": {
          "action": {
            "enum": [
              "ACCOUNT_DELETION"
            ],
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "action",
          "password"
        ],
        "type": "object"
      },
      "ReauthenticationResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReauthenticationDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "RegisterAccountRequestDto": {
        "properties": {
          "email": {
            "example": "kullanici@example.com",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "type": "string",
            "writeOnly": true
          },
          "passwordConfirmation": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "type": "string",
            "writeOnly": true
          },
          "termsAccepted": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password",
          "passwordConfirmation",
          "termsAccepted"
        ],
        "type": "object"
      },
      "RegistrationAcceptedDataDto": {
        "properties": {
          "next": {
            "example": "/verify-email",
            "type": "string"
          },
          "status": {
            "enum": [
              "VERIFICATION_REQUIRED"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "next"
        ],
        "type": "object"
      },
      "RegistrationAcceptedResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RegistrationAcceptedDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ResetPasswordRequestDto": {
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "type": "string",
            "writeOnly": true
          },
          "passwordConfirmation": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "type": "string",
            "writeOnly": true
          },
          "token": {
            "maxLength": 512,
            "minLength": 32,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "password",
          "passwordConfirmation"
        ],
        "type": "object"
      },
      "SessionStateDataDto": {
        "properties": {
          "absoluteExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "authenticated": {
            "type": "boolean"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "idleExpiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "authenticated"
        ],
        "type": "object"
      },
      "SessionStateResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SessionStateDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "UpdateCurrentUserRequestDto": {
        "properties": {
          "timeZone": {
            "example": "Europe/Istanbul",
            "type": "string"
          }
        },
        "required": [
          "timeZone"
        ],
        "type": "object"
      },
      "VerifyEmailDataDto": {
        "properties": {
          "next": {
            "example": "/login",
            "type": "string"
          },
          "status": {
            "enum": [
              "VERIFIED"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "next"
        ],
        "type": "object"
      },
      "VerifyEmailRequestDto": {
        "properties": {
          "code": {
            "example": "12345678",
            "maxLength": 8,
            "minLength": 8,
            "pattern": "^\\d{8}$",
            "type": "string",
            "writeOnly": true
          },
          "email": {
            "example": "kullanici@example.com",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "type": "object"
      },
      "VerifyEmailResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/VerifyEmailDataDto"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "VersionResponseDto": {
        "properties": {
          "version": {
            "example": "0.0.0",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "REST contract for the personal task planner.",
    "title": "Personal Task Planner API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "getAuthCsrf",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfTokenResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Issue a CSRF token for an anonymous authentication transaction",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/email-verification-requests": {
      "post": {
        "operationId": "requestEmailVerification",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerificationRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailVerificationRequestAcceptedResponseDto"
                }
              }
            },
            "description": ""
          },
          "422": {
            "description": "Safe validation details."
          },
          "429": {
            "description": "Generic verification request rate limit."
          }
        },
        "summary": "Request a fresh verification email without account enumeration",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/email-verifications": {
      "post": {
        "operationId": "verifyEmail",
        "parameters": [
          {
            "description": "A unique key for this verification attempt.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailResponseDto"
                }
              }
            },
            "description": ""
          },
          "409": {
            "description": "The code was already used or the idempotent request is still processing."
          },
          "422": {
            "description": "Safe validation or invalid/expired-code details."
          },
          "429": {
            "description": "Generic verification rate limit."
          }
        },
        "summary": "Verify a pending email identity with a manual code",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/password-reset-requests": {
      "post": {
        "operationId": "requestPasswordReset",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetRequestAcceptedResponseDto"
                }
              }
            },
            "description": ""
          },
          "422": {
            "description": "Safe validation details."
          },
          "429": {
            "description": "Generic password reset request rate limit."
          }
        },
        "summary": "Request a password reset email without account enumeration",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/password-resets": {
      "post": {
        "operationId": "resetPassword",
        "parameters": [
          {
            "description": "A unique key for this password reset attempt.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed and existing sessions revoked."
          },
          "409": {
            "description": "The idempotent request is still processing."
          },
          "422": {
            "description": "Safe validation or invalid/expired-token details."
          },
          "429": {
            "description": "Generic password reset rate limit."
          }
        },
        "summary": "Set a new password with a password reset token",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/reauthentications": {
      "post": {
        "operationId": "reauthenticate",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReauthenticationRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReauthenticationResponseDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Current session or password did not authenticate."
          },
          "429": {
            "description": "Generic reauthentication rate limit."
          }
        },
        "summary": "Confirm the current password for one short-lived sensitive account action",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "registerAccount",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccountRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationAcceptedResponseDto"
                }
              }
            },
            "description": ""
          },
          "422": {
            "description": "Safe validation details."
          },
          "429": {
            "description": "Generic registration rate limit."
          }
        },
        "summary": "Submit an email/password registration without account enumeration",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/session": {
      "delete": {
        "operationId": "deleteAuthSession",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Current session is absent or revoked and its cookie is cleared."
          },
          "403": {
            "description": "Origin or CSRF validation failed."
          }
        },
        "summary": "Idempotently revoke the current opaque session before clearing its cookie",
        "tags": [
          "Authentication"
        ]
      },
      "get": {
        "operationId": "getAuthSession",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStateResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Read safe current session state without exposing a session identifier",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/sessions": {
      "post": {
        "operationId": "createAuthSession",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Credentials did not authenticate."
          },
          "409": {
            "description": "Correct credentials require email verification before sign-in."
          },
          "429": {
            "description": "Generic login rate limit."
          }
        },
        "summary": "Create a rotated opaque session with verified email/password credentials",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "operationId": "getCurrentUser",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserProfileResponseDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "No valid authenticated session is present."
          }
        },
        "summary": "Read the current account profile resolved only from the active session",
        "tags": [
          "Users"
        ]
      },
      "patch": {
        "operationId": "updateCurrentUser",
        "parameters": [
          {
