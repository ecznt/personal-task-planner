generator client {
  provider     = "prisma-client"
  output       = "../src/platform/database/generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum JobState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AccountLifecycleState {
  ACTIVE
  DELETION_CONFIRMED
}

enum OnboardingState {
  PENDING
  COMPLETED
}

enum CanonicalStatus {
  TO_DO
  IN_PROGRESS
  COMPLETED
}

enum PlanningLifecycleState {
  ACTIVE
  ARCHIVED
  TRASHED
}

enum LifecycleOperationKind {
  ARCHIVE
  TRASH
  RESTORE
  PERMANENT_DELETE
}

enum LifecycleOperationState {
  PENDING
  COMPLETED
  FAILED
}

enum LifecycleEntityKind {
  AREA
  PROJECT
  TASK
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrenceSeriesState {
  ACTIVE
  PAUSED
  STOPPED
}

enum RecurrenceMode {
  CALENDAR_BASED
  COMPLETION_BASED
}

enum RecurrenceFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceRuleState {
  ACTIVE
  SUPERSEDED
  STOPPED
}

enum IdentityVerificationState {
  PENDING
  ACTIVE
}

enum AuthAbuseAction {
  REGISTRATION
  EMAIL_VERIFICATION_REQUEST
  EMAIL_VERIFICATION_CONFIRMATION
  LOGIN
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_CONFIRMATION
  REAUTHENTICATION
}

enum IdempotencyState {
  PROCESSING
  COMPLETED
}

enum ReauthenticationAction {
  ACCOUNT_DELETION
}

enum AccountDeletionProcessState {
  PENDING_PRIMARY_PURGE
  COMPLETED
}

model Job {
  id                BigInt    @id @default(autoincrement())
  type              String
  payload           Json
  state             JobState  @default(PENDING)
  availableAt       DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  attemptCount      Int       @default(0)
  leaseOwner        String?
  leaseToken        String?   @db.Uuid
  leaseExpiresAt    DateTime? @db.Timestamptz(3)
  lastErrorCategory String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([state, availableAt, id], map: "job_pending_claim_idx")
  @@index([state, leaseExpiresAt, id], map: "job_expired_lease_idx")
}

model User {
  id                                String                   @id @default(uuid()) @db.Uuid
  primaryEmail                      String
  normalizedPrimaryEmail            String                   @unique(map: "user_normalized_primary_email_key")
  timeZone                          String                   @default("UTC")
  inAppReminderNotificationsEnabled Boolean                  @default(true)
  onboardingState                   OnboardingState          @default(PENDING)
  onboardingCompletedAt             DateTime?                @db.Timestamptz(3)
  accountLifecycleState             AccountLifecycleState    @default(ACTIVE)
  deletionConfirmedAt               DateTime?                @db.Timestamptz(3)
  accessRevokedAt                   DateTime?                @db.Timestamptz(3)
  version                           Int                      @default(1)
  createdAt                         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime                 @updatedAt @db.Timestamptz(3)
  authenticationIdentity            AuthenticationIdentity?
  sessions                          Session[]
  reauthenticationProofs            ReauthenticationProof[]
  accountDeletionProcesses          AccountDeletionProcess[]
  areas                             Area[]
  areaStatuses                      AreaStatus[]
  projects                          Project[]
  tasks                             Task[]
  labels                            Label[]
  taskLabels                        TaskLabel[]
  checklistItems                    ChecklistItem[]
  recurrenceSeries                  RecurrenceSeries[]
  recurrenceRuleVersions            RecurrenceRuleVersion[]
  reminders                         TaskReminder[]
  notifications                     Notification[]
  lifecycleOperations               LifecycleOperation[]
  lifecycleEffects                  LifecycleEffect[]

  @@map("users")
}

model AuthenticationIdentity {
  id                      String                       @id @default(uuid()) @db.Uuid
  userId                  String                       @unique(map: "authentication_identity_user_id_key") @db.Uuid
  normalizedEmail         String                       @unique(map: "authentication_identity_normalized_email_key")
  verificationState       IdentityVerificationState    @default(PENDING)
  enabled                 Boolean                      @default(true)
  passwordHash            String
  verifiedAt              DateTime?                    @db.Timestamptz(3)
  lastAuthenticatedAt     DateTime?                    @db.Timestamptz(3)
  disabledAt              DateTime?                    @db.Timestamptz(3)
  disabledReason          String?
  version                 Int                          @default(1)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                     @updatedAt @db.Timestamptz(3)
  user                    User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationChallenges  EmailVerificationChallenge[]
  passwordResetChallenges PasswordResetChallenge[]

  @@map("authentication_identities")
}

model ReauthenticationProof {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @db.Uuid
  sessionId  String                 @db.Uuid
  action     ReauthenticationAction
  expiresAt  DateTime               @db.Timestamptz(3)
  consumedAt DateTime?              @db.Timestamptz(3)
  createdAt  DateTime               @default(now()) @db.Timestamptz(3)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, action, expiresAt], map: "reauthentication_proof_session_action_expiry_idx")
  @@index([expiresAt], map: "reauthentication_proof_expiry_idx")
  @@map("reauthentication_proofs")
}

model EmailVerificationChallenge {
  id                       String                 @id @default(uuid()) @db.Uuid
  authenticationIdentityId String                 @db.Uuid
  tokenHash                String                 @unique(map: "email_verification_challenge_token_hash_key")
  expiresAt                DateTime               @db.Timestamptz(3)
  consumedAt               DateTime?              @db.Timestamptz(3)
  invalidatedAt            DateTime?              @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  authenticationIdentity   AuthenticationIdentity @relation(fields: [authenticationIdentityId], references: [id], onDelete: Cascade)

  @@index([authenticationIdentityId, expiresAt], map: "email_verification_challenge_identity_expiry_idx")
  @@map("email_verification_challenges")
}

model PasswordResetChallenge {
  id                       String                 @id @default(uuid()) @db.Uuid
  authenticationIdentityId String                 @db.Uuid
  tokenHash                String                 @unique(map: "password_reset_challenge_token_hash_key")
  expiresAt                DateTime               @db.Timestamptz(3)
  consumedAt               DateTime?              @db.Timestamptz(3)
  invalidatedAt            DateTime?              @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  authenticationIdentity   AuthenticationIdentity @relation(fields: [authenticationIdentityId], references: [id], onDelete: Cascade)

  @@index([authenticationIdentityId, expiresAt], map: "password_reset_challenge_identity_expiry_idx")
  @@map("password_reset_challenges")
}

model AnonymousAuthTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  browserTokenHash String   @unique(map: "anonymous_auth_transaction_browser_token_hash_key")
  csrfTokenHash    String
  expiresAt        DateTime @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt], map: "anonymous_auth_transaction_expiry_idx")
  @@map("anonymous_auth_transactions")
}

model Session {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @db.Uuid
  tokenHash              String                  @unique(map: "session_token_hash_key")
  idleExpiresAt          DateTime                @db.Timestamptz(3)
  absoluteExpiresAt      DateTime                @db.Timestamptz(3)
  lastSeenAt             DateTime                @db.Timestamptz(3)
  revokedAt              DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reauthenticationProofs ReauthenticationProof[]

  @@index([userId, revokedAt, lastSeenAt, id], map: "session_user_active_lru_idx")
  @@index([idleExpiresAt, absoluteExpiresAt], map: "session_expiry_idx")
  @@map("sessions")
}

model AccountDeletionProcess {
  id              String                      @id @default(uuid()) @db.Uuid
  userId          String                      @db.Uuid
  state           AccountDeletionProcessState @default(PENDING_PRIMARY_PURGE)
  requestedAt     DateTime                    @db.Timestamptz(3)
  accessRevokedAt DateTime                    @db.Timestamptz(3)
  completedAt     DateTime?                   @db.Timestamptz(3)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(3)
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, state], map: "account_deletion_process_user_state_key")
  @@index([state, updatedAt], map: "account_deletion_process_state_progress_idx")
  @@map("account_deletion_processes")
}

model AuthAbuseCounter {
  id              BigInt          @id @default(autoincrement())
  action          AuthAbuseAction
  keyHash         String
  windowStartedAt DateTime        @db.Timestamptz(3)
  requestCount    Int             @default(1)
  expiresAt       DateTime        @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([action, keyHash, windowStartedAt], map: "auth_abuse_counter_window_key")
  @@index([expiresAt], map: "auth_abuse_counter_expiry_idx")
  @@map("auth_abuse_counters")
}

model IdempotencyRecord {
  id                 String           @id @default(uuid()) @db.Uuid
  keyHash            String           @unique(map: "idempotency_record_key_hash_key")
  requestFingerprint String
  method             String
  route              String
  state              IdempotencyState @default(PROCESSING)
  responseStatus     Int?
  responseBody       Json?
  expiresAt          DateTime         @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([expiresAt], map: "idempotency_record_expiry_idx")
  @@map("idempotency_records")
}

model Area {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @db.Uuid
  name           String
  normalizedName String
  lifecycleState PlanningLifecycleState @default(ACTIVE)
  archivedAt     DateTime?              @db.Timestamptz(3)
  trashedAt      DateTime?              @db.Timestamptz(3)
  purgeAfter     DateTime?              @db.Timestamptz(3)
  currentLifecycleOperationId String?    @db.Uuid
  currentLifecycleOperation  LifecycleOperation? @relation("AreaLifecycleOperation", fields: [currentLifecycleOperationId], references: [id], onDelete: SetNull)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  statuses       AreaStatus[]
  projects       Project[]
  tasks          Task[]
  lifecycleEffects LifecycleEffect[] @relation("AreaLifecycleEffect")

  @@unique([userId, normalizedName], map: "area_user_normalized_name_key")
  @@index([userId, lifecycleState, updatedAt, id], map: "area_user_lifecycle_idx")
  @@index([userId, lifecycleState, purgeAfter, id], map: "area_user_purge_idx")
  @@map("areas")
}

model AreaStatus {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  areaId          String          @db.Uuid
  name            String
  normalizedName  String
  canonicalStatus CanonicalStatus
  position        Int
  isDefault       Boolean         @default(false)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  area            Area            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@unique([areaId, normalizedName], map: "area_status_area_normalized_name_key")
  @@unique([areaId, position], map: "area_status_area_position_key")
  @@index([userId, areaId, canonicalStatus, isDefault], map: "area_status_default_lookup_idx")
  @@map("area_statuses")
}

model Project {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @db.Uuid
  areaId         String                 @db.Uuid
  name           String
  normalizedName String
  lifecycleState PlanningLifecycleState @default(ACTIVE)
  archivedAt     DateTime?              @db.Timestamptz(3)
  trashedAt      DateTime?              @db.Timestamptz(3)
  purgeAfter     DateTime?              @db.Timestamptz(3)
  currentLifecycleOperationId String?    @db.Uuid
  currentLifecycleOperation  LifecycleOperation? @relation("ProjectLifecycleOperation", fields: [currentLifecycleOperationId], references: [id], onDelete: SetNull)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  area           Area                   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  tasks          Task[]
  lifecycleEffects LifecycleEffect[] @relation("ProjectLifecycleEffect")

  @@unique([areaId, normalizedName], map: "project_area_normalized_name_key")
  @@index([userId, lifecycleState, updatedAt, id], map: "project_user_lifecycle_idx")
  @@index([userId, lifecycleState, purgeAfter, id], map: "project_user_purge_idx")
  @@map("projects")
}

model Task {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @db.Uuid
  areaId         String                 @db.Uuid
  projectId      String?                @db.Uuid
  areaStatusId   String                 @db.Uuid
  title          String
  description    String?
  plannedAt      DateTime?              @db.Timestamptz(3)
  dueAt          DateTime?              @db.Timestamptz(3)
  priority       TaskPriority           @default(MEDIUM)
  completedAt    DateTime?              @db.Timestamptz(3)
  lifecycleState PlanningLifecycleState @default(ACTIVE)
  archivedAt     DateTime?              @db.Timestamptz(3)
  trashedAt      DateTime?              @db.Timestamptz(3)
  purgeAfter     DateTime?              @db.Timestamptz(3)
  currentLifecycleOperationId String?    @db.Uuid
  currentLifecycleOperation  LifecycleOperation? @relation("TaskLifecycleOperation", fields: [currentLifecycleOperationId], references: [id], onDelete: SetNull)
  globalRank     String
  areaRank       String
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  area           Area                   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  areaStatus     AreaStatus             @relation(fields: [areaStatusId], references: [id], onDelete: Restrict)
  labels                   TaskLabel[]
  checklistItems           ChecklistItem[]
  recurrenceRuleVersion    RecurrenceRuleVersion?   @relation(fields: [recurrenceRuleVersionId], references: [id])
  recurrenceRuleVersionId  String?                  @db.Uuid
  recurrenceSeries         RecurrenceSeries?        @relation("ProducedBySeries", fields: [recurrenceSeriesId], references: [id])
  recurrenceSeriesId       String?                  @db.Uuid
  occurrenceNumber         Int?
  predecessorTask          Task?                    @relation("PredecessorSuccessor", fields: [predecessorTaskId], references: [id])
  predecessorTaskId        String?                  @db.Uuid @unique
  successorTask            Task?                    @relation("PredecessorSuccessor")
  generationKey            String?                  @unique
  currentOpenSeries        RecurrenceSeries?        @relation("CurrentOpenTask")
  lastCompletedBySeries    RecurrenceSeries?        @relation("LastCompletedBySeries")
  reminders                TaskReminder[]
  lifecycleEffects         LifecycleEffect[] @relation("TaskLifecycleEffect")

  @@index([userId, lifecycleState, updatedAt, id], map: "task_user_lifecycle_idx")
  @@index([userId, areaId, lifecycleState, areaRank, id], map: "task_area_rank_idx")
  @@index([userId, lifecycleState, globalRank, id], map: "task_global_rank_idx")
  @@index([userId, dueAt, id], map: "task_user_due_idx")
  @@index([recurrenceSeriesId, occurrenceNumber], map: "task_recurrence_series_occurrence_idx")
  @@index([userId, lifecycleState, purgeAfter, id], map: "task_user_purge_idx")
  @@map("tasks")
}

model RecurrenceSeries {
  id                          String                @id @default(uuid()) @db.Uuid
  userId                      String                @db.Uuid
  state                       RecurrenceSeriesState @default(ACTIVE)
  currentOpenTaskId           String?               @db.Uuid @unique
  lastCompletedTaskId         String?               @db.Uuid @unique
  nextOccurrenceNumber        Int                   @default(2)
  activeRuleVersionId         String                @db.Uuid
  createdAt                   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime              @updatedAt @db.Timestamptz(3)
  user                        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentOpenTask             Task?                 @relation("CurrentOpenTask", fields: [currentOpenTaskId], references: [id])
  lastCompletedTask           Task?                 @relation("LastCompletedBySeries", fields: [lastCompletedTaskId], references: [id])
  ruleVersions                RecurrenceRuleVersion[]
  tasks                       Task[]                @relation("ProducedBySeries")

  @@index([userId, state], map: "recurrence_series_user_state_idx")
  @@map("recurrence_series")
}

model RecurrenceRuleVersion {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  seriesId        String               @db.Uuid
  versionNumber   Int
  mode            RecurrenceMode
  frequency       RecurrenceFrequency
  interval        Int                  @default(1)
  selectedWeekdays Int[]               @default([])
  dayOfMonth      Int?
  monthOfYear     Int?
  localTime       String?
  state           RecurrenceRuleState  @default(ACTIVE)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  series          RecurrenceSeries     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@unique([seriesId, versionNumber], map: "recurrence_rule_version_series_version_key")
  @@index([userId], map: "recurrence_rule_version_user_idx")
  @@map("recurrence_rule_versions")
}

model Label {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  name           String
  normalizedName String
  color          String?
  version        Int         @default(1)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskLabels     TaskLabel[]

  @@unique([userId, normalizedName], map: "label_user_normalized_name_key")
  @@map("labels")
}

model TaskLabel {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  taskId    String   @db.Uuid
  labelId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, labelId], map: "task_label_user_task_label_key")
  @@index([userId, labelId, taskId], map: "task_label_user_label_idx")
  @@map("task_labels")
}

model ChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  taskId      String    @db.Uuid
  text        String
  position    Int
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position], map: "checklist_item_task_position_key")
  @@index([userId, taskId, position], map: "checklist_item_user_task_position_idx")
  @@map("checklist_items")
}

enum ReminderAnchorType {
  PLANNED
  DUE
}

enum ReminderRuleType {
  OFFSET
  AT_TIME
}

enum ReminderState {
  SCHEDULED
  TRIGGERED
  SUPPRESSED
  PAUSED
  CANCELLED
}

model TaskReminder {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  taskId          String           @db.Uuid
  anchorType      ReminderAnchorType
  ruleType        ReminderRuleType
  offsetMinutes   Int?
  atTime          DateTime?        @db.Timestamptz(3)
  scheduledAt     DateTime         @db.Timestamptz(3)
  state           ReminderState    @default(SCHEDULED)
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  notification    Notification?

  @@unique([taskId, anchorType, ruleType, offsetMinutes, atTime], map: "task_reminder_unique_def")
  @@index([state, scheduledAt, id], map: "task_reminder_trigger_idx")
  @@index([userId, taskId], map: "task_reminder_user_task_idx")
  @@map("task_reminders")
}

enum NotificationReadState {
  UNREAD
  READ
}

model Notification {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  taskReminderId  String                @unique @db.Uuid
  title           String
  body            String?
  readState       NotificationReadState @default(UNREAD)
  version         Int                   @default(1)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskReminder    TaskReminder          @relation(fields: [taskReminderId], references: [id], onDelete: Cascade)

  @@index([userId, readState, createdAt, id], map: "notification_user_read_idx")
  @@map("notifications")
}

model LifecycleOperation {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @db.Uuid
  kind           LifecycleOperationKind
  rootKind       LifecycleEntityKind
  rootId         String                  @db.Uuid
  state          LifecycleOperationState @default(PENDING)
  startedAt      DateTime                @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?               @db.Timestamptz(3)
  failureSummary String?
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  effects        LifecycleEffect[]
  areas          Area[]                  @relation("AreaLifecycleOperation")
  projects       Project[]               @relation("ProjectLifecycleOperation")
  tasks          Task[]                  @relation("TaskLifecycleOperation")

  @@index([userId, kind, rootKind, rootId], map: "lifecycle_op_user_root_idx")
  @@index([userId, startedAt, id], map: "lifecycle_op_user_started_idx")
  @@map("lifecycle_operations")
}

model LifecycleEffect {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @db.Uuid
  operationId    String               @db.Uuid
  affectedKind   LifecycleEntityKind
  affectedId     String               @db.Uuid
  previousState  PlanningLifecycleState
  resultingState PlanningLifecycleState
  effectTime     DateTime             @default(now()) @db.Timestamptz(3)
  previousArchivedAt DateTime?        @db.Timestamptz(3)
  previousTrashedAt  DateTime?        @db.Timestamptz(3)
  previousPurgeAfter DateTime?        @db.Timestamptz(3)
  reversedAt     DateTime?            @db.Timestamptz(3)
  reversed       Boolean              @default(false)
  replacementAreaId  String?          @db.Uuid
  replacementProjectId String?        @db.Uuid
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation      LifecycleOperation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  affectedArea   Area?                @relation("AreaLifecycleEffect", fields: [affectedId], references: [id], onDelete: Cascade, map: "lifecycle_effects_affected_area_fkey")
  affectedProject Project?            @relation("ProjectLifecycleEffect", fields: [affectedId], references: [id], onDelete: Cascade, map: "lifecycle_effects_affected_project_fkey")
  affectedTask   Task?                @relation("TaskLifecycleEffect", fields: [affectedId], references: [id], onDelete: Cascade, map: "lifecycle_effects_affected_task_fkey")

  @@index([operationId, reversed], map: "lifecycle_effect_operation_reversed_idx")
  @@index([userId, affectedKind, affectedId], map: "lifecycle_effect_entity_idx")
  @@map("lifecycle_effects")
}
