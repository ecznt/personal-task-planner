generator client {
  provider     = "prisma-client"
  output       = "../src/platform/database/generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum JobState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AccountLifecycleState {
  ACTIVE
  DELETION_CONFIRMED
}

enum OnboardingState {
  PENDING
  COMPLETED
}

enum IdentityVerificationState {
  PENDING
  ACTIVE
}

enum AuthAbuseAction {
  REGISTRATION
  EMAIL_VERIFICATION_REQUEST
  EMAIL_VERIFICATION_CONFIRMATION
  LOGIN
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_CONFIRMATION
  REAUTHENTICATION
}

enum IdempotencyState {
  PROCESSING
  COMPLETED
}

enum ReauthenticationAction {
  ACCOUNT_DELETION
}

enum AccountDeletionProcessState {
  PENDING_PRIMARY_PURGE
  COMPLETED
}

model Job {
  id                BigInt    @id @default(autoincrement())
  type              String
  payload           Json
  state             JobState  @default(PENDING)
  availableAt       DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  attemptCount      Int       @default(0)
  leaseOwner        String?
  leaseToken        String?   @db.Uuid
  leaseExpiresAt    DateTime? @db.Timestamptz(3)
  lastErrorCategory String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([state, availableAt, id], map: "job_pending_claim_idx")
  @@index([state, leaseExpiresAt, id], map: "job_expired_lease_idx")
}

model User {
  id                                String                  @id @default(uuid()) @db.Uuid
  primaryEmail                      String
  normalizedPrimaryEmail            String                  @unique(map: "user_normalized_primary_email_key")
  timeZone                          String                  @default("UTC")
  inAppReminderNotificationsEnabled Boolean                 @default(true)
  onboardingState                   OnboardingState         @default(PENDING)
  onboardingCompletedAt             DateTime?               @db.Timestamptz(3)
  accountLifecycleState             AccountLifecycleState   @default(ACTIVE)
  deletionConfirmedAt               DateTime?               @db.Timestamptz(3)
  accessRevokedAt                   DateTime?               @db.Timestamptz(3)
  version                           Int                     @default(1)
  createdAt                         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime                @updatedAt @db.Timestamptz(3)
  authenticationIdentity            AuthenticationIdentity?
  sessions                          Session[]
  reauthenticationProofs             ReauthenticationProof[]
  accountDeletionProcesses           AccountDeletionProcess[]

  @@map("users")
}

model AuthenticationIdentity {
  id                     String                       @id @default(uuid()) @db.Uuid
  userId                 String                       @unique(map: "authentication_identity_user_id_key") @db.Uuid
  normalizedEmail        String                       @unique(map: "authentication_identity_normalized_email_key")
  verificationState      IdentityVerificationState    @default(PENDING)
  enabled                Boolean                      @default(true)
  passwordHash           String
  verifiedAt             DateTime?                    @db.Timestamptz(3)
  lastAuthenticatedAt    DateTime?                    @db.Timestamptz(3)
  disabledAt             DateTime?                    @db.Timestamptz(3)
  disabledReason         String?
  version                Int                          @default(1)
  createdAt              DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @db.Timestamptz(3)
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationChallenges EmailVerificationChallenge[]
  passwordResetChallenges PasswordResetChallenge[]

  @@map("authentication_identities")
}

model ReauthenticationProof {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @db.Uuid
  sessionId  String                 @db.Uuid
  action     ReauthenticationAction
  expiresAt  DateTime               @db.Timestamptz(3)
  consumedAt DateTime?              @db.Timestamptz(3)
  createdAt  DateTime               @default(now()) @db.Timestamptz(3)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, action, expiresAt], map: "reauthentication_proof_session_action_expiry_idx")
  @@index([expiresAt], map: "reauthentication_proof_expiry_idx")
  @@map("reauthentication_proofs")
}

model EmailVerificationChallenge {
  id                       String                 @id @default(uuid()) @db.Uuid
  authenticationIdentityId String                 @db.Uuid
  tokenHash                String                 @unique(map: "email_verification_challenge_token_hash_key")
  expiresAt                DateTime               @db.Timestamptz(3)
  consumedAt               DateTime?              @db.Timestamptz(3)
  invalidatedAt            DateTime?              @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  authenticationIdentity   AuthenticationIdentity @relation(fields: [authenticationIdentityId], references: [id], onDelete: Cascade)

  @@index([authenticationIdentityId, expiresAt], map: "email_verification_challenge_identity_expiry_idx")
  @@map("email_verification_challenges")
}

model PasswordResetChallenge {
  id                       String                 @id @default(uuid()) @db.Uuid
  authenticationIdentityId String                 @db.Uuid
  tokenHash                String                 @unique(map: "password_reset_challenge_token_hash_key")
  expiresAt                DateTime               @db.Timestamptz(3)
  consumedAt               DateTime?              @db.Timestamptz(3)
  invalidatedAt            DateTime?              @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  authenticationIdentity   AuthenticationIdentity @relation(fields: [authenticationIdentityId], references: [id], onDelete: Cascade)

  @@index([authenticationIdentityId, expiresAt], map: "password_reset_challenge_identity_expiry_idx")
  @@map("password_reset_challenges")
}

model AnonymousAuthTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  browserTokenHash String   @unique(map: "anonymous_auth_transaction_browser_token_hash_key")
  csrfTokenHash    String
  expiresAt        DateTime @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt], map: "anonymous_auth_transaction_expiry_idx")
  @@map("anonymous_auth_transactions")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique(map: "session_token_hash_key")
  idleExpiresAt     DateTime  @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  lastSeenAt        DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reauthenticationProofs ReauthenticationProof[]

  @@index([userId, revokedAt, lastSeenAt, id], map: "session_user_active_lru_idx")
  @@index([idleExpiresAt, absoluteExpiresAt], map: "session_expiry_idx")
  @@map("sessions")
}

model AccountDeletionProcess {
  id              String                      @id @default(uuid()) @db.Uuid
  userId          String                      @db.Uuid
  state           AccountDeletionProcessState @default(PENDING_PRIMARY_PURGE)
  requestedAt     DateTime                    @db.Timestamptz(3)
  accessRevokedAt DateTime                    @db.Timestamptz(3)
  completedAt     DateTime?                   @db.Timestamptz(3)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(3)
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, state], map: "account_deletion_process_user_state_key")
  @@index([state, updatedAt], map: "account_deletion_process_state_progress_idx")
  @@map("account_deletion_processes")
}

model AuthAbuseCounter {
  id              BigInt          @id @default(autoincrement())
  action          AuthAbuseAction
  keyHash         String
  windowStartedAt DateTime        @db.Timestamptz(3)
  requestCount    Int             @default(1)
  expiresAt       DateTime        @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([action, keyHash, windowStartedAt], map: "auth_abuse_counter_window_key")
  @@index([expiresAt], map: "auth_abuse_counter_expiry_idx")
  @@map("auth_abuse_counters")
}

model IdempotencyRecord {
  id                 String           @id @default(uuid()) @db.Uuid
  keyHash            String           @unique(map: "idempotency_record_key_hash_key")
  requestFingerprint String
  method             String
  route              String
  state              IdempotencyState @default(PROCESSING)
  responseStatus     Int?
  responseBody       Json?
  expiresAt          DateTime         @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([expiresAt], map: "idempotency_record_expiry_idx")
  @@map("idempotency_records")
}
