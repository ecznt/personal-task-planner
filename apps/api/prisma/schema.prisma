generator client {
  provider     = "prisma-client"
  output       = "../src/platform/database/generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum JobState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Job {
  id                BigInt    @id @default(autoincrement())
  type              String
  payload           Json
  state             JobState  @default(PENDING)
  availableAt       DateTime  @default(now()) @db.Timestamptz(3)
  attemptCount      Int       @default(0)
  leaseOwner        String?
  leaseToken        String?   @db.Uuid
  leaseExpiresAt    DateTime? @db.Timestamptz(3)
  lastErrorCategory String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([state, availableAt, id], map: "job_pending_claim_idx")
  @@index([state, leaseExpiresAt, id], map: "job_expired_lease_idx")
}
