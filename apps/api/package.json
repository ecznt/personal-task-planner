{
  "name": "@planner/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "lint": "eslint .",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test:api": "jest --config test/jest-api.config.cjs --runInBand",
    "test:db": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-db.config.cjs --runInBand",
    "test:unit": "jest --config test/jest-unit.config.cjs --runInBand",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@planner/config": "workspace:*",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.3",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@planner/eslint-config": "workspace:*",
    "@planner/typescript-config": "workspace:*",
    "@redocly/cli": "2.39.0",
    "@testcontainers/postgresql": "12.0.4",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
