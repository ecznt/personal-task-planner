NODE_ENV=development
DATABASE_URL=postgresql://planner:planner_dev@127.0.0.1:5432/personal_task_planner
AUTH_SECURITY_KEY=replace-with-at-least-32-random-characters
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:3000
SMTP_FROM=planner@example.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USERNAME and SMTP_PASSWORD are optional locally and must be set together.
# SMTP_USERNAME=
# SMTP_PASSWORD=
TRUST_PROXY_HOPS=0
COOKIE_SECURE=false
LOG_LEVEL=debug
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=30000
NEXT_PUBLIC_API_BASE_PATH=/api/v1
API_INTERNAL_ORIGIN=http://127.0.0.1:3001
